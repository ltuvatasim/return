<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mushak-9.1 Automated Analyzer</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- PDF.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    </script>
</head>
<body class="bg-gray-50 text-gray-800 font-sans p-6">
    <div class="max-w-4xl mx-auto bg-white shadow-lg rounded-xl p-8">
        <h1 class="text-2xl font-bold text-indigo-600 mb-4 text-center">মুশক-৯.১ (Mushak-9.1) রিটার্ন অ্যানালাইজার</h1>
        <p class="text-sm text-gray-500 mb-6 text-center">আপনার ভ্যাট রিটার্ন পিডিএফ আপলোড করুন অথবা ডেমো ডাটা দিয়ে তাৎক্ষণিক পরীক্ষা করুন।</p>

        <!-- Control Buttons -->
        <div class="flex flex-col sm:flex-row justify-center gap-4 mb-8">
            <label class="cursor-pointer bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 px-5 rounded-lg shadow text-center transition">
                পিডিএফ ফাইল সিলেক্ট করুন
                <input type="file" id="pdfFile" accept="application/pdf" class="hidden">
            </label>
            <button id="demoBtn" class="bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 px-5 rounded-lg shadow transition">
                ডেমো ডাটা লোড করুন
            </button>
        </div>

        <div id="status" class="text-center font-medium text-gray-600 mb-4"></div>

        <!-- Result Tables Container -->
        <div id="results" class="hidden space-y-6">
            <!-- Part 3 -->
            <div class="border rounded-lg p-4 bg-indigo-50/50">
                <h2 class="font-bold text-lg text-indigo-700 mb-3">৩. পার্ট-৩: সাপ্লাই ও আউটপুট ট্যাক্স</h2>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
                    <div class="bg-white p-3 rounded shadow-sm"><strong>মোট বিক্রয় ভ্যালু (নোট ৯ক):</strong> <span id="res_s_val">0</span></div>
                    <div class="bg-white p-3 rounded shadow-sm"><strong>মোট এসডি (নোট ৯খ):</strong> <span id="res_s_sd">0</span></div>
                    <div class="bg-white p-3 rounded shadow-sm"><strong>মোট ভ্যাট (নোট ৯গ):</strong> <span id="res_s_vat">0</span></div>
                </div>
            </div>

            <!-- Part 4 -->
            <div class="border rounded-lg p-4 bg-blue-50/50">
                <h2 class="font-bold text-lg text-blue-700 mb-3">৪. পার্ট-৪: ক্রয় ও ইনপুট ট্যাক্স ক্রেডিট</h2>
                <div class="bg-white p-3 rounded shadow-sm text-sm">
                    <strong>মোট ইনপুট ট্যাক্স ক্রেডিট ভ্যাট (নোট ২৩খ):</strong> <span id="res_in_vat">0</span>
                </div>
            </div>

            <!-- Part 7 -->
            <div class="border rounded-lg p-4 bg-emerald-50/50">
                <h2 class="font-bold text-lg text-emerald-700 mb-3">৭. পার্ট-৭: নিট ট্যাক্স গণনা</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                    <div class="bg-white p-3 rounded shadow-sm"><strong>নিট প্রদেয় ভ্যাট (নোট ৩৪):</strong> <span id="res_n34" class="font-bold text-indigo-600">0</span></div>
                    <div class="bg-white p-3 rounded shadow-sm"><strong>চূড়ান্ত প্রদেয় ভ্যাট (নোট ৩৫):</strong> <span id="res_n35" class="font-bold text-emerald-600">0</span></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function displayData(data) {
            // হিসাব নিকাশ
            let totalSalesVal = data.note1_val + data.note3_val + data.note4_val;
            let totalSalesSD = data.note4_sd;
            let totalSalesVAT = data.note4_vat;
            let totalInputVAT = data.note14_vat + data.note15_vat + data.note16_vat;
            let note34 = totalSalesVAT - totalInputVAT + data.note28_adj - data.note33_adj;
            let note35 = note34 - (data.note52_bal + data.note56_bal);

            // ইউআই-এ বসানো
            document.getElementById('res_s_val').innerText = totalSalesVal.toLocaleString() + ' টাকা';
            document.getElementById('res_s_sd').innerText = totalSalesSD.toLocaleString() + ' টাকা';
            document.getElementById('res_s_vat').innerText = totalSalesVAT.toLocaleString() + ' টাকা';
            document.getElementById('res_in_vat').innerText = totalInputVAT.toLocaleString() + ' টাকা';
            document.getElementById('res_n34').innerText = note34.toLocaleString() + ' টাকা';
            document.getElementById('res_n35').innerText = note35.toLocaleString() + ' টাকা';

            document.getElementById('results').classList.remove('hidden');
            document.getElementById('status').innerText = '';
        }

        // ডেমো ডাটা বাটন হ্যান্ডলার
        document.getElementById('demoBtn').addEventListener('click', function() {
            const demoData = {
                note1_val: 153682016.30,
                note3_val: 4686113.79,
                note4_val: 3091265137.11,
                note4_sd: 843473520.48,
                note4_vat: 590210798.63,
                note14_vat: 85109909.03,
                note15_vat: 201525568.47,
                note16_vat: 5858186.64,
                note28_adj: 7968927.96,
                note33_adj: 46363256.07,
                note52_bal: 103167860.33,
                note56_bal: 0
            };
            displayData(demoData);
            document.getElementById('status').innerText = ' সফলভাবে ডেমো ডাটা লোড করা হয়েছে!';
            document.getElementById('status').className = 'text-center font-medium text-emerald-600 mb-4';
        });

        // পিডিএফ ফাইল আপলোড হ্যান্ডলার
        document.getElementById('pdfFile').addEventListener('change', async function(e) {
            const file = e.target.files[0];
            if (!file) return;

            document.getElementById('status').innerText = 'পিডিএফ প্রসেস হচ্ছে, অনুগ্রহ করে অপেক্ষা করুন...';
            document.getElementById('status').className = 'text-center font-medium text-indigo-600 mb-4';

            try {
                const arrayBuffer = await file.arrayBuffer();
                const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
                let fullText = "";

                for (let i = 1; i <= pdf.numPages; i++) {
                    const page = await pdf.getPage(i);
                    const textContent = await page.getTextContent();
                    fullText += textContent.items.map(item => item.str).join(" ") + " ";
                }

                // যদি পিডিএফ থেকে টেক্সট রিড করা সফল হয়, তবে ইউজারকে জানানো বা ফলব্যাক দেখানো
                // স্ট্যান্ডার্ড মুশক ফরম্যাট জটিল হওয়ায় পিডিএফের টেক্সট স্ট্রিকচার অনুযায়ী রেগুলার এক্সপ্রেশন বা ডেমো ফলব্যাক ব্যবহার করা যায়।
                alert('পিডিএফ সফলভাবে রিড করা হয়েছে! (নোটস ভ্যালু স্ক্যানিংয়ের জন্য ডেমো ডাটা দেখতে পারেন বা কাস্টম পার্সিং রুল যুক্ত করতে পারেন)।');
                
                // সাময়িকভাবে ডেমো ডাটা দিয়ে প্রিভিউ দেখানোর ব্যবস্থা:
                document.getElementById('demoBtn').click();

            } catch (err) {
                console.error(err);
                document.getElementById('status').innerText = ' ফাইলটি পড়তে সমস্যা হয়েছে। দয়া করে সঠিক ডিজিটাল পিডিএফ আপলোড করুন।';
                document.getElementById('status').className = 'text-center font-medium text-red-600 mb-4';
            }
        });
    </script>
</body>
</html>
